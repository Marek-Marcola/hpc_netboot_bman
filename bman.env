VERSION_ENV="260914"

# set variables in \$HOME/.bman.env or cli:
#  - os_cid (Cluster ID)
#  - os_sid (System ID)

if [[ "$os_sid" = "rocky-10.2" ]]; then
  : ${os_dist:=rocky}
  : ${os_ver:=10.2}
  : ${os_cfg:=r10-base,r10-auth,r10-lfs,r10-hpc,r10-virt}
  INFO="Rocky 10.2"
fi

